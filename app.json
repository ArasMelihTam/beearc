{
  "expo": {
    "name": "Beearc",
    "slug": "beearc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beearc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Beearc adds photos you choose to your hive inspection records. Photos stay on this phone.",
          "cameraPermission": "Beearc uses the camera to photograph frames and add them to your hive inspection records. Photos stay on this phone."
        }
      ]
    ],
    "locales": {
      "en": "./assets/locales/en.json",
      "tr": "./assets/locales/tr.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
